{
  "club": {
    "name": "Management Strategy Council",
    "shortName": "MSC",
    "campus": "University of Toronto Scarborough",
    "instagram": "https://www.instagram.com/msc.uoft/",
    "handle": "@msc.uoft",
    "tagline": "Learn. Network. Succeed.",
    "linkedin": "https://www.linkedin.com/company/msc-uoft"
  },
  "events": [
    {
      "id": "summit",
      "name": "Strategy Summit",
      "category": "Technology & strategy",
      "format": "Student-led case competition",
      "status": "Second edition · 2026",
      "description": "Turn an everyday observation into a product worth building. A student-led case competition at the intersection of technology, strategy and entrepreneurship.",
      "image": "assets/briefcase.webp",
      "art": "mountains",
      "note": "Teams of 4–5. Open to all programs. Registration closes October 26 at noon. Follow @msc.uoft for the registration link and event schedule.",
      "edition": "02",
      "focus": "Go-to-market strategy & brand positioning",
      "audience": "University of Toronto tri-campus, with UTSC at the heart.",
      "teamSize": "4–5 students",
      "registrationClose": "October 26 at noon",
      "earlyBird": "$35 · through October 21",
      "regular": "$40",
      "experience": [
        {
          "name": "Hear from industry leaders",
          "text": "A panel bringing industry perspectives into the room, with a focus on technology, strategy and the start-up space."
        },
        {
          "name": "Take on a real-world case",
          "text": "Research an opportunity, gather data and survey insights, analyse the evidence, then present a strategy your team can stand behind."
        },
        {
          "name": "Build your network",
          "text": "Meet students across programs and campuses, and connect with people working in the spaces you want to explore."
        },
        {
          "name": "Capture the experience",
          "text": "LinkedIn headshots and team-photo stations are planned, giving you a way to leave with a professional portrait and a memory of your team.",
          "planned": true
        }
      ],
      "takeaways": [
        {
          "name": "Stronger skills",
          "text": "Practise research, data gathering, surveying, analysis and presenting a clear recommendation."
        },
        {
          "name": "Industry insights",
          "text": "Explore technology, go-to-market strategy, start-ups and the opportunities emerging in wearable tech."
        },
        {
          "name": "Meaningful connections",
          "text": "Build relationships with peers and industry professionals through shared work and conversation."
        },
        {
          "name": "Greater confidence",
          "text": "Make decisions with imperfect information and explain the thinking behind your ideas."
        },
        {
          "name": "An entrepreneurial perspective",
          "text": "Learn to turn an everyday observation into a product idea, then consider how to bring it to market."
        }
      ]
    }
  ],
  "departments": [
    {
      "name": "Co-Presidents",
