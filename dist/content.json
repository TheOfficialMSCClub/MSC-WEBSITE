  "words": [
    {
      "term": "iteration",
      "type": "MSC Word of the Week",
      "definition": "Repeating a process, using what you learn each time to improve the next version.",
      "example": "Revise your case presentation after feedback. Test the next version. Keep what works; improve what doesn’t.",
      "source": "An existing MSC Word of the Week topic; definition paraphrased for this website."
    },
    {
      "term": "trade-off",
      "type": "Preview entry",
      "definition": "A choice in which gaining one benefit means giving up another.",
      "example": "Choosing a smaller event can mean fewer attendees, but more time for each conversation.",
      "source": "Illustrative strategy explainer. Not yet confirmed as a published MSC Word of the Week."
    },
    {
      "term": "positioning",
      "type": "Preview entry",
      "definition": "The distinct place an organization aims to occupy in the minds of its audience.",
      "example": "Decide who your event is for and what makes it valuable before writing the promotion.",
      "source": "Illustrative strategy explainer. Not yet confirmed as a published MSC Word of the Week."
    }
  ],
